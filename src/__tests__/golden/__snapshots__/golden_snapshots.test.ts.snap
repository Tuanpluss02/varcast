import 'collections/number_variables/number_variables.dart';
import 'collections/typography/typography.dart';

class AppTheme {
  AppTheme._();

  static GlobalColors get globalColors =>
      DesignSystemController.instance.globalColors;

  static ColorModes get colorModes =>
      DesignSystemController.instance.colorModes;

  static NumberVariables get numberVariables =>
      DesignSystemController.instance.numberVariables;

  static Typography get typography =>
      DesignSystemController.instance.typography;

  static const DSStyles textStyles = DSStyles();
  static const DSShadows shadows = DSShadows();
  static const DSColorStyles colorStyle = DSColorStyles();

  static void setGlobalColorsMode(GlobalColorsMode m, {Duration? duration}) =>
      DesignSystemController.instance.setGlobalColorsMode(m, duration: duration);

  static void setColorModesMode(ColorModesMode m, {Duration? duration}) =>
      DesignSystemController.instance.setColorModesMode(m, duration: duration);

  static void setNumberVariablesMode(NumberVariablesMode m, {Duration? duration}) =>
      DesignSystemController.instance.setNumberVariablesMode(m, duration: duration);

  static void setTypographyMode(TypographyMode m, {Duration? duration}) =>
      DesignSystemController.instance.setTypographyMode(m, duration: duration);

  /// Default animation duration for mode transitions. Defaults to [Duration.zero].
  static Duration get defaultDuration =>
      DesignSystemController.instance.defaultDuration;

  static set defaultDuration(Duration d) {
    assert(!d.isNegative, 'defaultDuration must not be negative');
    DesignSystemController.instance.defaultDuration = d;
  }

  static void setAnimationDuration(Duration d) => defaultDuration = d;

  static GlobalColorsMode get currentGlobalColorsMode =>
      DesignSystemController.instance.currentGlobalColorsMode;

  static ColorModesMode get currentColorModesMode =>
      DesignSystemController.instance.currentColorModesMode;

  static NumberVariablesMode get currentNumberVariablesMode =>
      DesignSystemController.instance.currentNumberVariablesMode;

  static TypographyMode get currentTypographyMode =>
      DesignSystemController.instance.currentTypographyMode;

}
