  {
    "contents": "import type { Dispatch, SetStateAction } from 'react';
import { globalColors } from '../tokens/tokens/global-colors';
import { colorModes } from '../tokens/tokens/color-modes';
import { numberVariables } from '../tokens/primitives/number-variables';
import { typography } from '../tokens/primitives/typography';

export type ThemeModeState = Record<string, string>;

export type Theme = {
  modes: ThemeModeState;
  setMode: (collection: string, mode: string) => void;
  [k: string]: any;
};

export function createTheme(
  modes: ThemeModeState = {},
  setModes?: Dispatch<SetStateAction<ThemeModeState>>,
): Theme {
  const setMode = (collection: string, mode: string) => {
    if (!setModes) return;
    setModes((prev: ThemeModeState) => ({ ...prev, [collection]: mode }));
  };

  const theme: Theme = {
    modes: {
  "globalColors": "valueMode",
  "colorModes": "lightMode",
  "numberVariables": "mode1Mode",
  "typography": "mediumMode",
      ...modes,
    },
    setMode,
  } as any;

  Object.defineProperty(theme, "globalColors", {
    enumerable: true,
    get: () => globalColors[theme.modes["globalColors"] as keyof typeof globalColors] ?? globalColors["valueMode" as any],
  });
  Object.defineProperty(theme, "colorModes", {
    enumerable: true,
    get: () => colorModes[theme.modes["colorModes"] as keyof typeof colorModes] ?? colorModes["lightMode" as any],
  });
  Object.defineProperty(theme, "numberVariables", {
    enumerable: true,
    get: () => numberVariables[theme.modes["numberVariables"] as keyof typeof numberVariables] ?? numberVariables["mode1Mode" as any],
  });
  Object.defineProperty(theme, "typography", {
    enumerable: true,
    get: () => typography[theme.modes["typography"] as keyof typeof typography] ?? typography["mediumMode" as any],
  });

  return theme;
}
