  },
  {
    "contents": "import 'package:flutter_test/flutter_test.dart';
import 'package:test_ds/test_ds.dart';

void main() {
  test('design system package loads', () {
    expect(AppTheme, isNotNull);
    expect(DesignSystemWrapper, isNotNull);
  });
}
",
